# DS Financial — Comprehensive .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.log

# Backend
backend/node_modules/
backend/dist/
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/logs/
backend/coverage/
backend/uploads/*
!backend/uploads/.gitkeep
backend/*.log
backend/server.log
backend/algos_output*.txt
backend/test_output*.txt

# Frontend
frontend/node_modules/
frontend/dist/

# Docker
docker-compose.override.yml

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Cache
.eslintcache
.stylelintcache
*.tsbuildinfo

# Temporary files
tmp/
temp/
.tmp*

# Surge deployment
surge_deploy/

# Secrets
**/secrets/
**/credentials/
*.pem
*.key
*.cert

# PDF exports
*.pdf

# Python (protection microservice)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Playwright / browser automation artifacts
.playwright-mcp/

# Reversible cleanup staging (Phase 1)
.cleanup-backup/
